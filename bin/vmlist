#!/usr/bin/env perl
use warnings;
use strict;

my $current_host;

# Default if no args are passed and STDIN is a terminal
unless (@ARGV || ! -t STDIN) {
    my $conf = (glob('~/.config/ssh/vm.conf'))[0];

    if ($conf && -f $conf) {
        @ARGV = ($conf);
    } else {
        warn "Error: VM config '$conf' does not exist.\n";
        exit 1;
    }
}

while (<>) {
    if (/^Host (\S+)$/) {
	$current_host = $1;
    } elsif (/^[\s]+ProxyJump (\S+)$/ && defined $current_host) {
	printf("%-15s %-15s\n", $current_host, $1);
	undef $current_host;
    }
}
