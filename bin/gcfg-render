#!/usr/bin/env perl
# gcfg-render: in-place identity substitution for dotfiles.
#
# Reads identity.defaults.sh (search values) and optionally
# identity.local.sh (replace values), then substitutes in registered
# files per render-registry. All substitutions for a file run in a
# single pass with searches ordered longest-first, so neither
# substring collisions between searches nor a replacement containing
# another search value can corrupt the result. Modified files are
# marked skip-worktree so git status stays clean.
#
# Usage:
#   gcfg-render render   # reset + substitute + skip-worktree
#   gcfg-render check    # verify defaults exist in registered files
#   gcfg-render reset    # restore skip-worktree files from HEAD

use warnings;
use strict;

my $home     = $ENV{HOME} or die "HOME not set\n";
my $dotbase  = $ENV{_DOTBASE}  // "$home/.config/shell";
my $registry = $ENV{_REGISTRY} // "$home/.local/share/dotfiles/render-registry";
my $mode     = $ARGV[0]        // '';

# In a bare checkout, .dotgit exists and we pass --git-dir/--work-tree
# explicitly. In a normal clone (e.g. pre-commit hook context), git's
# own GIT_DIR is already set, so we use plain git. Otherwise, when HOME
# itself is a clone, run git from there so manual invocations work from
# any cwd.
my $bare = -d "$home/.dotgit" ? 1 : 0;

my $GIT_ERR = 0;    # wait status of the last git() call (0 = success)

# --- helpers ---------------------------------------------------------------

sub parse_identity {
    my ( $name, @lines ) = @_;
    my %out;
    for my $ln (@lines) {
        $ln =~ s/^\s+//;
        $ln =~ s/\s+$//;
        next unless length $ln;
        next if $ln =~ /^#/;

        # Double-quoted (\" and \\ escape per shell), single-quoted
        # (fully literal), or bare word. A trailing # comment is
        # allowed after any form. Values containing # must be quoted.
        my ( $var, $val );
        if ( $ln =~ /^([A-Z_]+)\s*=\s*"((?:\\.|[^"\\])*)"\s*(?:#.*)?$/ ) {
            ( $var, $val ) = ( $1, $2 );
            $val =~ s/\\(["\\])/$1/g;
        }
        elsif ( $ln =~ /^([A-Z_]+)\s*=\s*'([^']*)'\s*(?:#.*)?$/ ) {
            ( $var, $val ) = ( $1, $2 );
        }
        elsif ( $ln =~ /^([A-Z_]+)\s*=\s*([^\s#'"]+)\s*(?:#.*)?$/ ) {
            ( $var, $val ) = ( $1, $2 );
        }

        if ( defined $var ) {
            if ( length $val ) { $out{$var} = $val }
            else { warn "gcfg: $name: empty value for $var ignored\n" }
        }
        else {
            warn "gcfg: $name: unrecognized line ignored: $ln\n";
        }
    }
    return %out;
}

sub source_identity {
    my ($file) = @_;
    return unless -r $file;
    open my $fh, '<', $file or die "Cannot read $file: $!\n";
    chomp( my @lines = <$fh> );
    close $fh;
    return parse_identity( $file, @lines );
}

# Defaults for check: prefer the index copy (what a commit will
# contain) and fall back to the worktree copy outside a repo or when
# the file is untracked.
sub check_defaults {
    my $rel = $dotbase =~ s{^\Q$home\E/}{}r;
    my $key = length $rel ? "$rel/identity.defaults.sh" : 'identity.defaults.sh';

    my @idx = git( 'show', ":$key" );
    if ( !$GIT_ERR && @idx ) {
        my %idx = parse_identity( "index:$key", @idx );
        if (%idx) {
            my %disk = source_identity("$dotbase/identity.defaults.sh");
            if ( %disk
                and join( '', map { "$_=$disk{$_}\n" } sort keys %disk )
                ne join( '', map { "$_=$idx{$_}\n" } sort keys %idx ) )
            {
                warn
                  "gcfg check: identity.defaults.sh differs on disk and in"
                  . " the index; checking the index copy\n";
            }
            return %idx;
        }
    }
    return source_identity("$dotbase/identity.defaults.sh");
}

sub read_registry {
    open my $fh, '<', $registry or die "Cannot read $registry: $!\n";
    my @rules;
    while (<$fh>) {
        s/#.*//;
        s/^\s+//;
        s/\s+$//;
        next unless /\S/;
        my ( $var, @files ) = split /\s+/;
        next unless $var && @files;
        push @rules, { var => $var, files => \@files };
    }
    close $fh;
    return @rules;
}

sub git {
    my (@args) = @_;
    my @prefix;
    if ($bare) {
        @prefix = ( "--git-dir=$home/.dotgit", "--work-tree=$home" );
    }
    elsif ( !defined $ENV{GIT_DIR} && -e "$home/.git" ) {
        @prefix = ( '-C', $home );
    }
    my $cmd = join( ' ', map { quotemeta } 'git', @prefix, @args );
    open my $pipe, '-|', "$cmd 2>/dev/null" or die "Cannot run git: $!\n";
    my @lines = <$pipe>;
    close $pipe;
    $GIT_ERR = $?;
    return @lines;
}

sub git_skip_worktree_files {
    my @out;
    for ( git( 'ls-files', '-v' ) ) {
        chomp;
        next unless /^S /;
        push @out, substr( $_, 2 );
    }
    return @out;
}

sub git_reset_file {
    my ($f) = @_;
    git( 'update-index', '--no-skip-worktree', $f );
    die "gcfg: git update-index failed for $f\n" if $GIT_ERR;
    git( 'checkout', 'HEAD', '--', $f );
    die "gcfg: git checkout HEAD -- $f failed\n" if $GIT_ERR;
}

sub git_set_skip_worktree {
    my ($f) = @_;
    git( 'update-index', '--skip-worktree', $f );
    die "gcfg: git update-index --skip-worktree failed for $f\n" if $GIT_ERR;
}

sub git_diff_quiet {
    my ($f) = @_;
    git( 'diff', '--quiet', 'HEAD', '--', $f );
    return 0 if $GIT_ERR == 256;    # exit 1: differences exist
    die "gcfg: git diff failed for $f\n" if $GIT_ERR;
    return 1;
}

# --- modes -----------------------------------------------------------------

sub do_reset {
    for my $f ( git_skip_worktree_files() ) {
        git_reset_file($f);
    }
}

sub do_render {
    my %defaults = source_identity("$dotbase/identity.defaults.sh");
    die "identity.defaults.sh not found in $dotbase\n" unless %defaults;

    my %replace = %defaults;
    if ( -r "$dotbase/identity.local.sh" ) {
        %replace = source_identity("$dotbase/identity.local.sh");
    }

    do_reset();

    my @rules = read_registry();

    # Collect per-file substitution lists.
    my %file_subs;
    for my $rule (@rules) {
        my $var    = $rule->{var};
        my $search = $defaults{$var};
        if ( !defined $search || !length $search ) {
            warn "gcfg render: $var not set in defaults\n";
            next;
        }
        my $repl = $replace{$var} // $search;
        next if $search eq $repl;
        for my $f ( @{ $rule->{files} } ) {
            push @{ $file_subs{$f} }, $var;
        }
    }

    my $count = 0;
    for my $f ( sort keys %file_subs ) {
        my $path = "$home/$f";
        if ( !-f $path ) {
            warn "gcfg render: $f: not on disk, skipped\n";
            next;
        }

        open my $fh, '<', $path or die "Cannot read $path: $!\n";
        local $/;
        my $content = <$fh> // '';
        close $fh;

        # Single pass, longest search first. Alternation ordered
        # longest-first makes the regex pick the longest default at
        # each position (no substring collisions between searches),
        # and one pass means replacement text is never re-scanned by a
        # later substitution (a replacement may safely contain another
        # search value, and two values may even swap). The /e hash
        # lookup inserts the replacement literally, so no escaping of
        # the replacement is needed or correct.
        my %map;
        for my $var ( @{ $file_subs{$f} } ) {
            my ( $s, $r ) =
              ( $defaults{$var}, $replace{$var} // $defaults{$var} );
            if ( defined $map{$s} && $map{$s} ne $r ) {
                warn "gcfg render: $f: '$s' has conflicting replacements;"
                  . " keeping '$map{$s}'\n";
            }
            else { $map{$s} = $r }
        }
        next unless %map;

        my @searches = sort { length $b <=> length $a } keys %map;
        my $alt      = join '|', map { quotemeta } @searches;
        my %hits;
        $content =~ s{($alt)}{ $hits{$1}++; $map{$1} }ge;

        # Surface drift (registry/file mismatch, uncommitted defaults
        # edits, lost skip-worktree bits) instead of substituting
        # nothing in silence.
        for my $s (@searches) {
            warn "gcfg render: $f: default value '$s' not found\n"
              unless $hits{$s};
        }

        open my $out, '>', $path or die "Cannot write $path: $!\n";
        print $out $content;
        close $out;

        git_set_skip_worktree($f) unless git_diff_quiet($f);
        $count++;
    }
    print "Rendered $count files.\n";
}

sub do_check {
    my %defaults = check_defaults();
    die "identity.defaults.sh not found in $dotbase\n" unless %defaults;

    my @rules = read_registry();
    my $fail  = 0;

    # Group rules by file so searches also run longest-first per file,
    # mirroring render: a short default must match on its own, not
    # merely inside a longer registered default.
    my %file_vars;
    for my $rule (@rules) {
        my $var    = $rule->{var};
        my $search = $defaults{$var};
        unless ( defined $search && length $search ) {
            print STDERR "gcfg check: $var not set in defaults\n";
            $fail = 1;
            next;
        }
        push @{ $file_vars{$_} }, $var for @{ $rule->{files} };
    }

    for my $f ( sort keys %file_vars ) {
        my @lines = git( 'show', ":$f" );
        if ($GIT_ERR) {
            print STDERR "gcfg check: cannot read :$f from the index\n";
            $fail = 1;
            next;
        }
        my $content = join '', @lines;

        my %map      = map { $defaults{$_} => $_ } @{ $file_vars{$f} };
        my @searches = sort { length $b <=> length $a } keys %map;
        my $alt      = join '|', map { quotemeta } @searches;
        my %hits;
        $hits{$1}++ while $content =~ /($alt)/g;

        for my $var ( @{ $file_vars{$f} } ) {
            unless ( $hits{ $defaults{$var} } ) {
                print STDERR "gcfg check: $var value not found in $f\n";
                $fail = 1;
            }
        }
    }

    if ($fail) { exit 1 }
    print "gcfg check: OK\n";
}

# --- dispatch --------------------------------------------------------------

unless ($mode) {
    die "Usage: gcfg-render [render|check|reset]\n";
}

if    ( $mode eq 'reset' )  { do_reset() }
elsif ( $mode eq 'render' ) { do_render() }
elsif ( $mode eq 'check' )  { do_check() }
else                        { die "Unknown mode: $mode\n" }
